---
const { descricao, progresso } = Astro.props;
---

<div class="flex flex-col gap-4 px-16 items-center place-self-stretch relative">
  <h4 class="text-xl text-white">{descricao}</h4>

  <div
    class="progress-bar flex justify-between items-center"
    style=`--progress: ${progresso}%`
  >
    <span class="">
      {progresso}%
    </span>
  </div>
</div>

<style>
  .progress-bar {
    width: 100%; 
    min-height: 1.125rem;
    background: linear-gradient(
      to right,
      #aea181 var(--progress),
      transparent var(--progress)
    );
    border-radius: 5px;
    overflow: hidden;
    border: solid 1px #aea181;
  }
  span {
    @apply text-xl font-bold py-2 border border-maggiore-dourado-400 self-stretch text-center block w-full;
  }
</style>
